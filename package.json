{
  "name": "campus-grievance-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Student grievance and facility maintenance ticketing system where PostgreSQL constraints, not application code, are the final authority on duplicate tickets, ticket ownership and maintenance overlap.",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "migrate": "ts-node src/data/migrate.ts",
    "seed": "ts-node src/scripts/seed.ts",
    "seed:docker": "docker compose exec api node dist/scripts/seed.js",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "test:concurrency": "jest --runInBand tests/concurrency.test.ts",
    "test:coverage": "jest --runInBand --coverage"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.15",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "eslint": "^9.9.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.1.0"
  }
}
